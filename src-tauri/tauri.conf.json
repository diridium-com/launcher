{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run generate",
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kiran Ayyagari",
    "icon": [
      "icons/32x32.icns",
      "icons/favicon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/*"
    ]
  },
  "productName": "Launcher",
  "mainBinaryName": "Launcher",
  "identifier": "sereen.io",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "title": "Launcher"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Launcher",
        "width": 900,
        "height": 600,
        "useHttpsScheme": true
      }
    ]
  }
}
